{
  "uid": "pawtograder-queues-workers",
  "title": "Pawtograder \u00b7 Queues & Workers",
  "tags": [
    "pawtograder",
    "queues",
    "workers"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total queued",
      "description": "Sum of visible messages across every pgmq queue. max() per metric because every edge-function pod exports these gauges.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max(pawtograder_async_queue_size) or vector(0)) + (max(pawtograder_async_low_priority_queue_size) or vector(0)) + (max(pawtograder_async_dlq_size) or vector(0)) + (max(pawtograder_gradebook_row_recalculate_queue_size) or vector(0)) + (max(pawtograder_gradebook_row_recalculate_dlq_size) or vector(0)) + (max(pawtograder_discord_queue_size) or vector(0)) + (max(pawtograder_discord_dlq_size) or vector(0)) + (max(pawtograder_notification_emails_queue_size) or vector(0))",
          "legendFormat": "queued"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Oldest message (live queues)",
      "description": "The scale-free health signal: depth needs a threshold tuned to enrollment and the deadline calendar, age does not. Excludes the DLQs (a poison message parks there forever, so its age would pin this stat) and async_calls_low_priority (drained only when async_calls is empty, so it is starved by design) - the same exclusions PawtograderQueueOldestMessageAging uses.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(pawtograder_queue_oldest_message_seconds{queue!~\".*_dlq|async_calls_low_priority\"})",
          "legendFormat": "oldest"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Dead-lettered (all DLQs)",
      "description": "A message reaches a DLQ only after exhausting its retries, so anything above zero is work that will never complete on its own.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max(pawtograder_async_dlq_size) or vector(0)) + (max(pawtograder_discord_dlq_size) or vector(0)) + (max(pawtograder_gradebook_row_recalculate_dlq_size) or vector(0))",
          "legendFormat": "dlq"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Notification email queued",
      "description": "Previously unreported entirely, which is why an email pipeline that delivered nothing looked healthy.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(pawtograder_notification_emails_queue_size)",
          "legendFormat": "emails"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Queue depth",
      "description": "Visible messages per queue. Depth alone cannot distinguish a busy queue from a stalled one \u2014 read it beside the age panel.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(pawtograder_async_queue_size)",
          "legendFormat": "GitHub async worker"
        },
        {
          "refId": "B",
          "expr": "max(pawtograder_async_low_priority_queue_size)",
          "legendFormat": "GitHub async (low priority)"
        },
        {
          "refId": "C",
          "expr": "max(pawtograder_async_dlq_size)",
          "legendFormat": "GitHub async DLQ"
        },
        {
          "refId": "D",
          "expr": "max(pawtograder_gradebook_row_recalculate_queue_size)",
          "legendFormat": "Gradebook row recalc"
        },
        {
          "refId": "E",
          "expr": "max(pawtograder_gradebook_row_recalculate_dlq_size)",
          "legendFormat": "Gradebook row recalc DLQ"
        },
        {
          "refId": "F",
          "expr": "max(pawtograder_discord_queue_size)",
          "legendFormat": "Discord async worker"
        },
        {
          "refId": "G",
          "expr": "max(pawtograder_discord_dlq_size)",
          "legendFormat": "Discord async DLQ"
        },
        {
          "refId": "H",
          "expr": "max(pawtograder_notification_emails_queue_size)",
          "legendFormat": "Notification email"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Oldest message age",
      "description": "A healthy busy queue has high depth and LOW age. A stalled queue has rising age regardless of depth. Includes messages deferred by retry backoff, which is exactly where a poison message hides. DLQs are excluded: nothing drains one on a schedule, so their age dwarfs the live queues on a shared axis - see 'Dead-letter growth (1h)' for those.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (pawtograder_queue_oldest_message_seconds{queue!~\".*_dlq\"})",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Dead-letter growth (1h)",
      "description": "Growth, not level. A poison message sits in a DLQ indefinitely, so a level reading stays high forever after the incident; growth shows whether failures are still arriving.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "delta(max(pawtograder_async_dlq_size)[1h:5m])",
          "legendFormat": "GitHub async DLQ"
        },
        {
          "refId": "B",
          "expr": "delta(max(pawtograder_discord_dlq_size)[1h:5m])",
          "legendFormat": "Discord async DLQ"
        },
        {
          "refId": "C",
          "expr": "delta(max(pawtograder_gradebook_row_recalculate_dlq_size)[1h:5m])",
          "legendFormat": "Gradebook row recalc DLQ"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Queue drain rate",
      "description": "Positive means the queue is draining, negative means it is filling faster than the workers consume. Flat zero on a non-empty queue means nothing is consuming it at all.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "-1 * min(deriv(pawtograder_async_queue_size[10m]))",
          "legendFormat": "GitHub async worker"
        },
        {
          "refId": "B",
          "expr": "-1 * min(deriv(pawtograder_async_low_priority_queue_size[10m]))",
          "legendFormat": "GitHub async (low priority)"
        },
        {
          "refId": "C",
          "expr": "-1 * min(deriv(pawtograder_async_dlq_size[10m]))",
          "legendFormat": "GitHub async DLQ"
        },
        {
          "refId": "D",
          "expr": "-1 * min(deriv(pawtograder_gradebook_row_recalculate_queue_size[10m]))",
          "legendFormat": "Gradebook row recalc"
        },
        {
          "refId": "E",
          "expr": "-1 * min(deriv(pawtograder_gradebook_row_recalculate_dlq_size[10m]))",
          "legendFormat": "Gradebook row recalc DLQ"
        },
        {
          "refId": "F",
          "expr": "-1 * min(deriv(pawtograder_discord_queue_size[10m]))",
          "legendFormat": "Discord async worker"
        },
        {
          "refId": "G",
          "expr": "-1 * min(deriv(pawtograder_discord_dlq_size[10m]))",
          "legendFormat": "Discord async DLQ"
        },
        {
          "refId": "H",
          "expr": "-1 * min(deriv(pawtograder_notification_emails_queue_size[10m]))",
          "legendFormat": "Notification email"
        }
      ]
    }
  ]
}
