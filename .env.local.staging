# Frontend-only dev against SELF-HOSTED staging (k8s on ripley).
# Generated by k8s/apps/pawtograder-staging/fetch-env-local.sh — re-run to refresh.
#
#   app     https://staging.pawtograder.net
#   api     https://api.staging.pawtograder.net
#   studio  https://studio.staging.pawtograder.net
#           (basic auth: bao kv get -field=user kv/apps/pawtograder-staging/studio-auth
#                        bao kv get -field=pass kv/apps/pawtograder-staging/studio-auth)
#
# THIS FILE IS TRACKED IN GIT. Public values only — the anon key and OAuth
# client id are browser-facing by design. Secrets live in the untracked
# .env.local.staging.priv; combine them with:
#
#   cat .env.local.staging .env.local.staging.priv > .env.local
#
# Login note: GoTrue's GOTRUE_URI_ALLOW_LIST on staging is https://staging.pawtograder.net/*, so an
# OAuth round-trip (GitHub / Discord / Entra) lands on the deployed site rather
# than localhost. For a local dev server, sign in with email + password.

NEXT_PUBLIC_SUPABASE_URL=https://api.staging.pawtograder.net
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InBhd3RvZ3JhZGVyLWFwaWtleXMtdjEifQ.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBhd3RvZ3JhZGVyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA0MTEwNjAsImV4cCI6MjA5NTc3MTA2MH0.E_TfAMzIU92QR4byFDNYnjPYK4AdALuAdgOcyW9Kz2M
NEXT_PUBLIC_PAWTOGRADER_WEB_URL=https://staging.pawtograder.net

# Matches the staging image's build arg. This only hides the signup UI
# (lib/features.ts) — GoTrue on staging still reports disable_signup=false, so a
# direct /auth/v1/signup call works if you need to create a user.
NEXT_PUBLIC_ENABLE_SIGNUPS=false

# No code reads this anymore, but release-images.yml still passes it as a build
# arg for the staging image; kept for parity.
NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID=Iv23lil6T0tynzac83eQ

# Channel routing (canary lane at canary.staging.pawtograder.net). Deliberately
# left unset: utils/channels.ts treats an unset CHANNEL_HOST_SUFFIX as "no
# channels", which is what you want locally — set it and the middleware will try
# to redirect canary-opted-in courses off your dev server.
# NEXT_PUBLIC_PAWTOGRADER_CHANNEL=stable
# NEXT_PUBLIC_CHANNEL_HOST_SUFFIX=.staging.pawtograder.net

# Product analytics — off locally on purpose (the staging image sets these from
# the STAGING_POSTHOG_* Actions secrets).
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# NEXT_PUBLIC_POSTHOG_UI_HOST=

# Staging runs the "PawtograderNext" skin (values-staging.yaml web.branding).
# Uncomment for visual parity with the deployed site.
# BRAND_NAME=PawtograderNext
# BRAND_DESCRIPTION=PawtograderNext — the next generation of Pawtograder course operations
# BRAND_TAGLINE=The next generation of your pawsome course companion
# BRAND_COLOR_PALETTE=teal
