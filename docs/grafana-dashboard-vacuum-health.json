    {
      "title": "Current Alert Table",
      "description": "All currently active vacuum health alerts with details",
      "type": "table",
      "id": 7,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": "$datasource",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "severity" },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [{ "color": "green", "value": null }]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "warning": { "color": "yellow", "index": 0, "text": "WARNING" },
                      "critical": { "color": "red", "index": 1, "text": "CRITICAL" }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "severity", "desc": true }]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true, "__name__": true },
            "renameByName": {
              "check": "Check",
              "severity": "Severity",
              "table_name": "Table"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "pawtograder_vacuum_alert{namespace=\"$namespace\", severity!=\"ok\"} == 1",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
