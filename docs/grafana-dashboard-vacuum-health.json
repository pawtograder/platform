      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": "$datasource",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
