# Bug reporter privacy guardrails (ADR 6 in the bug reporter spec).
#
# PLACEHOLDER OWNER: replace @pawtograder/pawtograder-owners with the real unmask
# owners team, which is a human decision. GitHub ignores a line whose owner does not exist, so
# these entries do nothing until the handle is real. The same team should be the required
# reviewers of the `report-unmask-review` environment (.github/workflows/report-unmask-review.yml),
# which covers the content rule CODEOWNERS cannot express: any diff adding `data-report-unmask`.
#
# These paths decide what the recorder may record as text and how that is checked, so changing
# them needs the same owners.
/lib/bugReport/privacy.ts @pawtograder/pawtograder-owners
/eslint-rules/ @pawtograder/pawtograder-owners
/eslint.pii.config.mjs @pawtograder/pawtograder-owners
/scripts/bugReport/brandPiiColumns.ts @pawtograder/pawtograder-owners
/scripts/bugReport/piiLintRatchet.mjs @pawtograder/pawtograder-owners
/.github/workflows/report-unmask-review.yml @pawtograder/pawtograder-owners
/.github/CODEOWNERS @pawtograder/pawtograder-owners
/lib/bugReport/recorder.ts @pawtograder/pawtograder-owners
/lib/bugReport/routePolicy.ts @pawtograder/pawtograder-owners
/lib/bugReport/redaction/ @pawtograder/pawtograder-owners
/components/bugReport/ReportBlock.tsx @pawtograder/pawtograder-owners
/lib/bugReport/generated/appRoutes.json @pawtograder/pawtograder-owners
