# Coder (helm.coder.com/v2) for Cloud Workspaces. Workspaces are plain runc
# pods in this same namespace; the chart's Role gives coderd pod/PVC rights
# here and nowhere else. Templates: deploy/workspaces/templates.
{{- $w := .Values.workspaces }}
{{- /* database.server: a postgres.instances entry, or the Pawtograder chart's Postgres */}}
{{- $dbHost := ternary "pawtograder-postgres" $w.database.server (eq $w.database.server "pawtograder") }}

coder:
  env:
    - name: CODER_ACCESS_URL
      value: https://{{ $w.host }}
    # Workspace apps on <app>--<workspace>--<user>.<domain>: one label, so
    # the namespace's wildcard cert covers them.
    - name: CODER_WILDCARD_ACCESS_URL
      value: "*.{{ .Values.domain }}"
    - name: CODER_TELEMETRY_ENABLE
      value: "false"
    # Accounts are made programmatically (scripts/add-user.sh). Password
    # signup is already closed once the first owner exists; also turn off
    # GitHub login through Coder's built-in OAuth app, which would otherwise
    # be on with no configuration at all.
    - name: CODER_OAUTH2_GITHUB_DEFAULT_PROVIDER_ENABLE
      value: "false"
    - name: CODER_OAUTH2_GITHUB_ALLOW_SIGNUPS
      value: "false"
    # Role + database made by scripts/ensure-database.sh (presync hook).
    - name: CODER_DB_PASSWORD
      valueFrom:
        secretKeyRef: { name: coder-db-credentials, key: CODER_DB_PASSWORD }
    - name: CODER_PG_CONNECTION_URL
      value: postgres://coder:$(CODER_DB_PASSWORD)@{{ $dbHost }}:5432/coder?sslmode=disable

  resources:
    requests: { cpu: 250m, memory: 512Mi }
    limits: { cpu: "1", memory: 1Gi }

  service:
    # LoadBalancer/NodePort aren't admitted in tenant namespaces; Ingress only.
    type: ClusterIP

  ingress:
    enable: true
    className: nginx
    host: {{ $w.host }}
    wildcardHost: "*.{{ .Values.domain }}"
    tls:
      enable: true
      secretName: {{ .Values.tlsSecret }}
      wildcardSecretName: {{ .Values.tlsSecret }}
