{{- $w := .Values.workspaces }}
{{- $dbHost := ternary "pawtograder-postgres" $w.database.server (eq $w.database.server "pawtograder") }}

coder:
  env:
    - name: CODER_ACCESS_URL
      value: https://{{ $w.host }}
    # Workspace app hosts stay one label deep so the wildcard cert covers them.
    - name: CODER_WILDCARD_ACCESS_URL
      value: "*.{{ .Values.domain }}"
    - name: CODER_TELEMETRY_ENABLE
      value: "false"
    # Coder's built-in GitHub OAuth app is on by default with no configuration.
    - name: CODER_OAUTH2_GITHUB_DEFAULT_PROVIDER_ENABLE
      value: "false"
    - name: CODER_OAUTH2_GITHUB_ALLOW_SIGNUPS
      value: "false"
    - name: CODER_DB_PASSWORD
      valueFrom:
        secretKeyRef: { name: coder-db-credentials, key: CODER_DB_PASSWORD }
    - name: CODER_PG_CONNECTION_URL
      value: postgres://coder:$(CODER_DB_PASSWORD)@{{ $dbHost }}:5432/coder?sslmode=disable

  resources:
    requests: { cpu: 250m, memory: 512Mi }
    limits: { cpu: "1", memory: 1Gi }

  service:
    # LoadBalancer/NodePort aren't admitted in tenant namespaces; Ingress only.
    type: ClusterIP

  ingress:
    enable: true
    className: nginx
    host: {{ $w.host }}
    wildcardHost: "*.{{ .Values.domain }}"
    tls:
      enable: true
      secretName: {{ .Values.tlsSecret }}
      wildcardSecretName: {{ .Values.tlsSecret }}
