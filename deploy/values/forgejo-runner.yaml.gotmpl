# Separate release so Forgejo is up before the registration hook runs.
{{- $r := .Values.forgejo.runner }}

resources:
  - apiVersion: v1
    kind: ConfigMap
    metadata:
      name: forgejo-runner
    data:
      config.yaml: |
        log:
          level: info
        runner:
          file: /data/.runner
          capacity: {{ $r.capacity }}
          timeout: 1h
          shutdown_timeout: 5m
          labels:
            - ubuntu-latest:host
            - ubuntu-24.04:host
            - ubuntu-22.04:host
        cache:
          enabled: true
          dir: /data/cache
        host:
          workdir_parent: /data/work
  - apiVersion: apps/v1
    kind: Deployment
    metadata:
      name: forgejo-runner
      labels: { app.kubernetes.io/name: forgejo-runner }
    spec:
      replicas: 1
      # One registration identity: never run two pods at once.
      strategy: { type: Recreate }
      selector:
        matchLabels: { app.kubernetes.io/name: forgejo-runner }
      template:
        metadata:
          labels: { app.kubernetes.io/name: forgejo-runner }
          annotations:
            checksum/runner: {{ toJson $r | sha256sum | trunc 16 }}
        spec:
          # Jobs run student code: no Kubernetes credentials.
          automountServiceAccountToken: false
          securityContext: { runAsUser: 1000, runAsGroup: 1000, fsGroup: 1000 }
          initContainers:
            - name: register
              image: {{ $r.image }}
              workingDir: /data
              args:
                - forgejo-runner
                - create-runner-file
                - --instance=http://forgejo-http:3000
                - --name={{ $r.name }}
                - --secret=$(RUNNER_SECRET)
              env:
                - name: RUNNER_SECRET
                  valueFrom:
                    secretKeyRef: { name: forgejo-runner, key: secret }
              resources:
                requests: { cpu: 50m, memory: 64Mi }
                limits: { cpu: 200m, memory: 128Mi }
              volumeMounts:
                - { name: data, mountPath: /data }
          containers:
            - name: runner
              image: {{ $r.image }}
              args: [forgejo-runner, daemon, --config, /etc/forgejo-runner/config.yaml]
              securityContext: { allowPrivilegeEscalation: false }
              resources:
                requests: { cpu: "1", memory: 2Gi }
                limits: { cpu: "2", memory: 4Gi }
              volumeMounts:
                - { name: data, mountPath: /data }
                - { name: config, mountPath: /etc/forgejo-runner, readOnly: true }
          volumes:
            - name: config
              configMap: { name: forgejo-runner }
            - name: data
              emptyDir: { sizeLimit: 20Gi }
