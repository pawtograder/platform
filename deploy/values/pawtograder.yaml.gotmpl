{{- $env := .Values }}
{{- $p := $env.pawtograder }}

global:
  # staging keeps the chart's guard rails without production's HA requirements.
  environment: staging
  hostname: {{ $p.host }}
  # app-api.<domain> stays one label deep; api.<hostname> would escape the wildcard cert.
  apiOnSeparateHost: true
  apiHostnameFlatten: true
  # The chart's own ServiceAccount doesn't carry the namespace's pull Secret.
  imagePullSecrets:
    - name: {{ $env.registryPullSecret }}

ingress:
  enabled: true
  className: nginx
  annotations:
    nginx.ingress.kubernetes.io/proxy-body-size: "55m"
    nginx.ingress.kubernetes.io/proxy-read-timeout: "3600"
    nginx.ingress.kubernetes.io/proxy-send-timeout: "3600"
  tls:
    enabled: true
    secretName: {{ $env.tlsSecret }}

secrets:
  create: false
  autogenerate: false
  externalSecret:
    enabled: false

postgres:
  persistence:
    storageClass: ""
    size: {{ $p.postgresStorage }}
  resources:
    requests: { cpu: 500m, memory: 2Gi }
    limits: { cpu: "2", memory: 4Gi }
  config:
    max_connections: "150"
    shared_buffers: "512MB"
    effective_cache_size: "2GB"

migrations:
  image:
    tag: {{ $p.imageTag | quote }}

supavisor:
  enabled: false

redis:
  provider: internal
  internal:
    maxmemory: "384mb"
    resources:
      requests: { cpu: 50m, memory: 128Mi }
      limits: { cpu: 250m, memory: 512Mi }

auth:
  replicas: 1
  resources:
    requests: { cpu: 50m, memory: 128Mi }
    limits: { cpu: 500m, memory: 512Mi }

rest:
  replicas: 1
  resources:
    requests: { cpu: 50m, memory: 256Mi }
    limits: { cpu: 500m, memory: 1Gi }

realtime:
  replicas: 1
  spreadAcrossNodes: false
  resources:
    requests: { cpu: 100m, memory: 256Mi }
    limits: { cpu: "1", memory: 1Gi }

storage:
  replicas: 1
  backend: s3
  s3:
    # storage-api hard-codes https, so this must be the public MinIO endpoint.
    endpoint: {{ $env.s3.externalEndpoint }}
    bucket: {{ $env.s3.bucket }}
    forcePathStyle: true
    region: us-east-1
  resources:
    requests: { cpu: 50m, memory: 128Mi }
    limits: { cpu: 500m, memory: 512Mi }

imgproxy:
  resources:
    requests: { cpu: 50m, memory: 64Mi }
    limits: { cpu: 250m, memory: 256Mi }

meta:
  enabled: false

studio:
  enabled: false

kong:
  replicas: 1
  resources:
    requests: { cpu: 100m, memory: 256Mi }
    limits: { cpu: "1", memory: 1Gi }

edgeFunctions:
  replicas: 1
  maxParallelism: 4
  image:
    tag: {{ $p.imageTag | quote }}
  {{- if $env.forgejo.enabled }}
  extraEnv:
    # validateOIDCToken trusts Actions job tokens issued by <FORGEJO_URL>/api/actions.
    - name: FORGEJO_URL
      value: https://{{ $env.forgejo.host }}
  {{- end }}
  resources:
    requests: { cpu: 200m, memory: 512Mi }
    limits: { cpu: "1", memory: 2Gi }

web:
  replicas: 1
  workflowMetricsLeader: true
  image:
    # NEXT_PUBLIC_* are compiled in, so the public ghcr.io image can't serve this host.
    repository: {{ $p.webImageRepository }}
    tag: {{ $p.imageTag | quote }}
    # Rebuilt under the same tag when keys are recreated.
    pullPolicy: Always
  extraEnv:
    # No Microsoft SSO app for this install; email + password only.
    - name: BRAND_SSO_PROVIDERS
      value: "[]"
  resources:
    requests: { cpu: 100m, memory: 512Mi }
    limits: { cpu: "1", memory: 2Gi }

monitoring:
  enabled: false

backup:
  enabled: false

tests:
  smoke:
    enabled: true
